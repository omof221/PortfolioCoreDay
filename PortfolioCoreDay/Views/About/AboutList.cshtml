@model List<PortfolioCoreDay.Entities.About>
@{
    ViewData["Title"] = "AboutList";
    Layout = "~/Views/AdminLayoutController1/Index.cshtml";
}

<h1>Hakkımda Listesi</h1>

<table class="table table-bordered">

    <tr>
        <th>#</th>
        <th>1. Hakkımda Açıklaması</th>
        <th>Yaş</th>
        <th>Doğum Tarihi</th>
        <th>Şehir</th>
        <th>Eğitim Durumu</th>
        <th>Mail</th>
        <th>Meslek Başlığı</th>
        <th>Meslek Başlığı Açıklaması</th>
        <th>Meslek Alanı Açıklaması</th>
        <th>Tel</th>
        <th>Web Site Url</th>
        <th>Sil</th>
        <th>Güncelle</th>

    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.AboutId</td>
            <td>@item.AboutDescription</td>
            <td>@item.Age</td>
            <td>@item.Birthday</td>
            <td>@item.City</td>
            <td>@item.Degree</td>
            <td>@item.Email</td>
            <td>@item.JobTitle</td>
            <td>@item.JobTitleDescription</td>
            <td>@item.LastDescription</td>
            <td>@item.PhoneNumber</td>
            <td>@item.WebsiteUrl</td>
            @* <td><a href="/TestimonialController1/DeleteTestimonial/@item.TestimonialID" class="btn btn-danger">Sil</a> </td>
            <td><a href="/TestimonialController1/UpdateTestimonial/@item.TestimonialID" class="btn btn-success">GÜncelle</a> </td> *@

        </tr>

    }

</table>
<a href="/AboutController/CreateAbout/" class="btn btn-info">Yeni Hakkımda  Girişi</a>