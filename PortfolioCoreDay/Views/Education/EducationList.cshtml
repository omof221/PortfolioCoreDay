@model List<Education>
@{
    ViewData["Title"] = "EducationList";
    Layout = "~/Views/AdminLayoutController1/Index.cshtml";
}

<h1>Eğitim Hayatım</h1>

<table class="table table-bordered">
    <tr>
        <th>#</th>
        <th>Eğitim İsmi</th>
        <th>Eğitim Kurumunun İsmi</th>
        <th>Departman</th>
        <th>Eğitim Tarihi</th>
        <th>Eğitim Açıklaması</th>
        <th>Sil</th>
        <th>Güncelle</th>


    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.EducationId</td>
            <td>@item.Title</td>
            <td>@item.University</td>
            <td>@item.Department</td>
            <td>@item.EducationDate</td>
            <td>@item.EducationDescription</td>
            <td><a href="/Education/DeleteEducation/@item.EducationId" class="btn btn-danger">Sil</a></td>
            <td><a href="/Education/UpdateEducation/@item.EducationId" class="btn btn-success">Güncelle</a></td>





        </tr>


    }




</table>

<a href="/Education/CreateEducation/" class="btn btn-primary">Yeni Eğitim Girişi</a>