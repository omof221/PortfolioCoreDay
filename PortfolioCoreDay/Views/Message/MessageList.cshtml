@model List<Message>
@{
    ViewData["Title"] = "MessageList";
    Layout = "~/Views/AdminLayoutController1/Index.cshtml";
}



<h4 class="page-title">Mesajlar</h4>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>#</th>
            <th>Gönderici</th>
            <th>Konu</th>
            <th>Tarih</th>
            <th>Mesajı Aç</th>
            <th>Durum</th>
            <th>Sil</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MessageId</td>
                <td>@item.NameSurname</td>
                <td>@item.Subject</td>
                <td>@item.SendDate.ToShortDateString()</td>
                <td>
                    <a href="/Message/MessageDetail/@item.MessageId" class="btn btn-warning">Mesaj Aç</a>
                </td>
                <td>
                    @if (item.IsRead)
                    {
                        <a href="/Message/ChangeIsReadFalse/@item.MessageId" class="btn btn-dark">Okunmadı İşaretle</a>
                    }
                    else
                    {
                        <a href="/Message/ChangeIsReadTrue/@item.MessageId" class="btn btn-info">Okundu İşaretle</a>
                    }
                </td>
                <td>
                    <a href="/Message/DeleteMessage/@item.MessageId" class="btn btn-danger">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>
