@model Message
@{
    ViewData["Title"] = "MessageDetail";
    Layout = "~/Views/AdminLayoutController1/Index.cshtml";
}


<h2>Mesaj Detayları</h2>

<input type="hidden" asp-for="MessageId" />

<table class="table table-bordered">
    <tr>
        <th>Gönderen</th>
        <td>@Model.NameSurname</td>
    </tr>
    <tr>
        <th>Email</th>
        <td>@Model.Email</td>
    </tr>
    <tr>
        <th>Tarih</th>
        <td>@Model.SendDate</td>
    </tr>
    <tr>
        <th>Mesaj</th>
        <td>@Model.MessageDeetail</td>
    </tr>
</table>


