@model Portfolio
@{
    ViewData["Title"] = "CreatePortfolio";
    Layout = "~/Views/AdminLayoutController1/Index.cshtml";
}

<h1>Yeni Proje Girişi</h1>

<form method="post">
    <label>Proje Başlığı</label>
    <input type="text" asp-for="Title" class="form-control" style="border:1px solid black;" />
    <br />
    <label>Proje Açıklaması</label>
    <input type="text" asp-for="Description" class="form-control" style="border:1px solid black;" />
    <br />
    <label>Proje Fotoğraf Url</label>
    <input type="text" asp-for="GithubUrl" class="form-control" style="border:1px solid black;" />
    <br />
    <label>Proje Kategorisi</label>
    <select asp-for="CategoryID" asp-items="ViewBag.v" class="form-control" style="border:1px solid black;" />
<option value="">  seçim</option>    
</select>
<button class="btn btn-primary">ekle</button>
    









</form>