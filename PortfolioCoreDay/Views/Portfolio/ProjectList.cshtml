@model List<Portfolio>
@{
    ViewData["Title"] = "ProjectList";
    Layout = "~/Views/AdminLayoutController1/Index.cshtml";
}



<div class="container mt-5">
    <h3 class="mb-4">Proje Listesi</h3>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="@item.ImageUrl" class="card-img-top" alt="Proje Görseli" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text">@item.Description</p>
                    </div>
                    <div class="card-footer d-flex justify-content-between">
                        <a href="/Portfolio/DeletePortfolio/@item.PortfolioId" class="btn btn-danger">Sil</a>
                        <a href="/Portfolio/UpdatePortfolio/@item.PortfolioId" class="btn btn-success">Güncelle</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mt-4">
        <a href="/Portfolio/CreatePortfolio" class="btn btn-primary">Yeni Proje Girişi</a>
    </div>
</div>