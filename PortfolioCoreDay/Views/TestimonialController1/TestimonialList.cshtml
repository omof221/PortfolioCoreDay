@model List<PortfolioCoreDay.Entities.Testimonial>
@{
    ViewData["Title"] = "TestimonialList";
    Layout = "~/Views/AdminLayoutController1/Index.cshtml";
}

<h1>Yeni Referans Girişi</h1>

<table class="table table-bordered">

    <tr>
        <th>#</th>
        <th>Referans Adı</th>
        <th>Referans Unvan</th>
        <th>Açıklama</th>
        <th>Sil</th>
        <th>Güncelle</th>

    </tr>
    @foreach(var item in Model)
    { <tr>
        <td>@item.TestimonialID</td>
        <td>@item.NameSurname</td>
        <td>@item.Title</td>
        <td>@item.Description</td>
            <td><a href="/TestimonialController1/DeleteTestimonial/@item.TestimonialID" class="btn btn-danger">Sil</a> </td>
            <td><a href="/TestimonialController1/UpdateTestimonial/@item.TestimonialID"  class="btn btn-success">GÜncelle</a> </td>

    </tr>

    }

</table>
<a href="/TestimonialController1/CreateTestimonial/" class="btn btn-info">Yeni Referans Girişi</a>