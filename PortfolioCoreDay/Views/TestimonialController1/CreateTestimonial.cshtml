@model PortfolioCoreDay.Entities.Testimonial
@{
    ViewData["Title"] = "CreateTestimonial";
    Layout = "~/Views/AdminLayoutController/Index.cshtml";
}

<h1>Yeni Referans Girişi</h1>
<form method="post">
    <label>Ad Soyad</label>
    <input type="text" asp-for="NameSurname" class="form-control" style="border:1px solid black;"/>
    <br />
     <label>Referans Unvan</label>
    <input type="text" asp-for="Title" class="form-control" style="border:1px solid black;" />
    <br />
     <label>Görsel Url</label>
    <input type="text" asp-for="ImmageUrl" class="form-control" style="border:1px solid black;" />
    <br />
     <label>Referans Açıklamsı</label>
    <textarea   class="form-control" asp-for="Description" style="border:1px solid black;" /> </textarea>
    <br />
    <button class="btn btn-primary">Referansı Kaydet</button>







</form>

