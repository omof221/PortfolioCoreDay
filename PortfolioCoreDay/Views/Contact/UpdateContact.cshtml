@model PortfolioCoreDay.Entities.Contact
@{
    ViewData["Title"] = "UpdateContact";
    Layout = "~/Views/AdminLayoutController1/Index.cshtml";
}

<h1>İletişim Güncelleme</h1>

<form method="post">
    <input type="hidden" asp-for="ContactId" />
    <label>Addres</label>
    <input type="text" asp-for="Address" class="form-control" style="border:1px solid black;" />
    <br />
    <label>TEL</label>
    <input type="text" asp-for="Callnumber" class="form-control" style="border:1px solid black;" />
    <br />
    <label>Email</label>
    <input type="text" asp-for="Emailus" class="form-control" style="border:1px solid black;" />
    <br />
    <label>API Konum Bilgisi</label>
    <input type="text" asp-for="Location" class="form-control" style="border:1px solid black;" />
    <br />



    <button class="btn btn-succes">İletişimi  Kaydet</button>







</form>