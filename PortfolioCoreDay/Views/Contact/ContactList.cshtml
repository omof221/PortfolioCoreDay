@model List<Contact>
@{
    ViewData["Title"] = "ContactList";
    Layout = "~/Views/AdminLayoutController1/Index.cshtml";
}

<h1>İletişim Tablosu</h1>

<table class="table table-bordered">
    <tr>
        <th>#</th>
        <th>Addres</th>
        <th>Telefon Numarası</th>
        <th>Email</th>
        <th>Konum Apı Verisi</th>
        <th>Sil</th>
        <th>Güncelle</th>


    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ContactId</td>
            <td>@item.Address</td>
            <td>@item.Callnumber</td>
            <td>@item.Emailus</td>
            <td>@item.Location</td>
         
            <td><a href="/Contact/DeleteContact/@item.ContactId" class="btn btn-danger">Sil</a></td>
            <td><a href="/Contact/UpdateContact/@item.ContactId" class="btn btn-success">Güncelle</a></td>





        </tr>


    }




</table>

<a href="/Contact/CreateContact/" class="btn btn-primary">Yeni İletişim Girişi</a>