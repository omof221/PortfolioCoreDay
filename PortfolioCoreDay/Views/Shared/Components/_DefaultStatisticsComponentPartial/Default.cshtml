<section id="stats" class="stats section">

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row gy-4">

            <div class="col-lg-3 col-md-6">
                <div class="stats-item">
                    <i class="bi bi-emoji-smile"></i>
                    <span data-purecounter-start="0" data-purecounter-end="@ViewBag.a1" data-purecounter-duration="1" class="purecounter"></span>
                    <p><strong>Number of Capabilities</strong> <span>###################</span></p>
                </div>
            </div><!-- End Stats Item -->

            <div class="col-lg-3 col-md-6">
                <div class="stats-item">
                    <i class="bi bi-journal-richtext"></i>
                    <span data-purecounter-start="0" data-purecounter-end="@ViewBag.a2" data-purecounter-duration="1" class="purecounter"></span>
                    <p><strong>Number of Projects</strong> <span>################</span></p>
                </div>
            </div><!-- End Stats Item -->

            <div class="col-lg-3 col-md-6">
                <div class="stats-item">
                    <i class="bi bi-headset"></i>
                    <span data-purecounter-start="0" data-purecounter-end="@ViewBag.a3" data-purecounter-duration="1" class="purecounter"></span>
                    <p><strong>Number of Incoming Messages</strong> <span>###################</span></p>
                </div>
            </div><!-- End Stats Item -->

            <div class="col-lg-3 col-md-6">
                <div class="stats-item">
                    <i class="bi bi-people"></i>
                    <span data-purecounter-start="0" data-purecounter-end="@ViewBag.a4" data-purecounter-duration="1" class="purecounter"></span>
                    <p><strong> Random number</strong> <span>#####################</span></p>
                </div>
            </div><!-- End Stats Item -->

        </div>

    </div>

</section><!-- /Stats Section -->